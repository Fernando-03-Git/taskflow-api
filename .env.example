APP_NAME=TaskFlow
APP_VERSION=1.0.0
DEBUG=True

# Genera una propia: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=cambia_esto_por_una_clave_larga_y_aleatoria

# Para correr con venv contra tu PostgreSQL local.
# Con Docker Compose esta linea se ignora: el compose la reemplaza por db:5432
DATABASE_URL=postgresql://usuario:password@localhost:5432/taskflow

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30